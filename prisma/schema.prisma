generator client {
  provider  = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FriendshipStatus{
  PENDING
  ACCEPTED
  BLOCKED
}

enum OnlineStatus{
  ONLINE
  ABSENT
  OFFLINE
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  username          String            @unique
  password          String
  createdAt         DateTime          @default(now())

  profilePicture    String            @default("https://res.cloudinary.com/dz4b2dabb/image/upload/v1773501304/default_akfhni.png")

  onlineStatus      OnlineStatus      @default(ONLINE)
  lastOnline        DateTime          @default(now())

  sentRequests      Friendship[]      @relation("sender")
  receivedRequests  Friendship[]      @relation("receiver")

  sentMessages      Message[]         @relation("sender")
  receivedMessages  Message[]         @relation("receiver")
}

model Friendship{
  id                String            @id @default(uuid())
  status            FriendshipStatus  @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  senderId          String
  sender            User              @relation("sender", fields: [senderId], references: [id])

  receiverId        String
  receiver          User              @relation("receiver", fields: [receiverId], references: [id])

  @@unique ([senderId, receiverId])
}

model Message{
  id                String            @id @default(uuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  senderId          String
  sender            User              @relation("sender", fields: [senderId], references: [id])

  receiverId        String
  receiver          User              @relation("receiver", fields: [receiverId], references: [id])

  message           String            
  images            String[]
}
